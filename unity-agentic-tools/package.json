{
  "name": "unity-agentic-tools",
  "packageManager": "bun@1.3.14",
  "version": "0.7.0",
  "description": "Compact Unity Editor command runner for AI agents",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:types && bun run build:lib && bun run build:cli",
    "build:types": "tsc --project tsconfig.json",
    "build:lib": "bun build src/index.ts --outdir=dist --target=bun --format=cjs",
    "build:cli": "bun build src/cli.ts --outdir=dist --target=bun --format=cjs && chmod +x dist/cli.js",
    "dev": "bun build src/index.ts --watch",
    "clean": "rm -rf dist",
    "rebuild": "bun run clean && bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unity-headless": "bun test/run-headless-validation.ts",
    "test:unity-editor-tests": "bun test/run-editor-tests.ts",
    "test:stress": "bun test/run-bridge-stress.ts"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vitest/ui": "^4.0.16",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "type": "commonjs",
  "bin": {
    "unity-agentic-tools": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taconotsandwich/unity-agentic-tools"
  },
  "keywords": [
    "unity",
    "yaml",
    "parser",
    "scene",
    "prefab",
    "gameobject",
    "ai",
    "cli"
  ],
  "license": "Apache-2.0"
}
